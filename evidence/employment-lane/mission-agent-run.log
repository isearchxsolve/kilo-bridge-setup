e = false;\n    for (const line of lines) {\n      if (line.includes('Easily apply')) continue;\n      if (!foundRole && !line.includes('Γé╣') && !line.includes('/') && !line.includes('Remote') && !line.includes('Hybrid') && !line.includes('On-site') && !line.includes('View similar jobs') && !line.includes('Often replies') && !line.includes('Posted') && !line.includes('Save') && !line.includes('Apply')) {\n        role = line;\n        foundRole = true;\n        continue;\n      }\n      if (foundRole && !line.includes('Γé╣') && !line.includes('/') && !line.includes('Remote') && !line.includes('Hybrid') && !line.includes('On-site') && !line.includes('View similar jobs') && !line.includes('Often replies') && !line.includes('Posted') && !line.includes('Save') && !line.includes('Apply') && line !== role) {\n        company = line;\n        break;\n      }\n    }\n    // Fallback: if we didn't find company, set to first line after role that is not empty and not \"Easily apply\"\n    if (!company) {\n      for (let i = 0; i < lines.length; i++) {\n        if (lines[i] === role) {\n          // look ahead\n          for (let j = i+1; j < lines.length; j++) {\n            if (lines[j] && !lines[j].includes('Easily apply') && lines[j] !== role) {\n              company = lines[j];\n              break;\n            }\n          }\n          break;\n        }\n      }\n    }\n    // If still empty, set to unknown\n    if (!role) role = 'Unknown';\n    if (!company) company = 'Unknown';\n    const key = role + '|' + company;\n    if (!jobsMap.has(key)) {\n      const lower = text.toLowerCase();\n      const matched = resumeSkillsLower.filter(skill => lower.includes(skill));\n      jobsMap.set(key, {role, company, score: matched.length, matchedSkills: matched.slice(0,10), isEasyApply, text});\n    }\n  }\n  // Convert map to array\n  const uniqueJobs = Array.from(jobsMap.values());\n  return uniqueJobs;\n})()"}
