[0mΓÜÖ [0mbrowser-mcp_browser_execute_script {"code":"(() => {\n  const saveLinks = Array.from(document.querySelectorAll('a')).filter(a => a.textContent.trim() === 'Save' || a.textContent.trim() === 'Hide');\n  const cards = [];\n  for (const link of saveLinks) {\n    let parent = link.parentElement;\n    // go up until we find a container that likely holds the job\n    for (let i=0; i<10 && parent; i++) {\n      if (parent.textContent && parent.textContent.length > 100 && parent.textContent.includes('Save') && parent.textContent.includes('Hide')) {\n        cards.push(parent);\n        break;\n      }\n      parent = parent.parentElement;\n    }\n  }\n  // deduplicate by outerHTML\n  const seen = new Set();\n  const unique = [];\n  for (const c of cards) {\n    const html = c.outerHTML;\n    if (!seen.has(html)) {\n      seen.add(html);\n      unique.push(c);\n    }\n  }\n  return unique.map(c => ({\n    text: c.textContent.slice(0,500),\n    outerHTML: c.outerHTML.slice(0,1000)\n  }));\n})()"}
[0mΓÜÖ [0mbrowser-mcp_browser_execute_script {"code":"(() => {\n  const all = Array.from(document.querySelectorAll('*'));\n  const saveEls = all.filter(el => el.textContent.trim() === 'Save');\n  const hideEls = all.filter(el => el.textContent.trim() === 'Hide');\n  const pairs = [];\n  for (const s of saveEls) {\n    for (const h of hideEls) {\n      if (s.parentElement === h.parentElement) {\n        pairs.push(s.parentElement);\n        break;\n      }\n    }\n  }\n  // get unique parents\n  const seen = new Set();\n  const unique = [];\n  for (const p of pairs) {\n    const id = p.dataset?.id || p.outerHTML;\n    if (!seen.has(id)) {\n      seen.add(id);\n      unique.push(p);\n    }\n  }\n  return unique.map(p => ({\n    text: p.textContent.slice(0,600),\n    html: p.outerHTML.slice(0,1000)\n  }));\n})()"}
[0mΓÜÖ [0mbrowser-mcp_browser_execute_script {"code":"(() => {\n  const all = Array.from(document.querySelectorAll('*'));\n  const cont = all.filter(el => el.textContent.includes('Save') && el.textContent.includes('Hide') && el.textContent.indexOf('Save') < el.textContent.indexOf('Hide'));\n  return cont.map(c => ({\n    text: c.textContent.slice(0,800),\n    class:c.className,\n    tag:c.tagName\n  }));\n})()"}
[0mΓÜÖ [0mbrowser-mcp_browser_execute_script {"code":"(() => {\n  const text = document.body.innerText;\n  // split by lines and try to group\n  const lines = text.split('\\n');\n  const jobs = [];\n  let current = [];\n  for (const line of lines) {\n    if (line.trim() === '') {\n      if (current.length > 0) {\n        jobs.push(current.join('\\n'));\n        current = [];\n      }\n    } else {\n      current.push(line);\n    }\n  }\n  if (current.length > 0) jobs.push(current.join('\\n'));\n  // filter those that look like job posts: contain \"Yrs\" and \"Lacs\" maybe\n  const jobBlocks = jobs.filter(b => b.includes('Yrs') && b.includes('Lacs') && b.length > 50);\n  return jobBlocks.map(b => b.slice(0,300));\n})()"}
