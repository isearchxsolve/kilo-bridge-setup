line that starts with \"Position:\" or contains \"Position:\"\n    for (const l of lines) {\n      if (l.startsWith('Position:')) {\n        title = l.substring('Position:'.length).trim();\n        // sometimes title includes location after comma? We'll take first part before comma if any\n        if (title.includes('Location:')) {\n          title = title.split('Location:')[0].trim();\n        }\n        break;\n      }\n    }\n    // if not found, maybe title is the line before \"Position:\"? Actually the line before Position is the experience line.\n    // Let's fallback: title is the line that does not contain Yrs, Lacs, Save, Hide, Reviews, Posted by, etc.\n    if (!title) {\n      for (const l of lines) {\n        if (!l.includes('Yrs') && !l.includes('Lacs') && !l.includes('Save') && !l.includes('Hide') && !l.includes('Reviews') && !l.includes('Posted by') && !l.includes('WeΓÇÖre urgently hiring') && !l.includes('Matching jobs promoted by companies') && !l.includes('Add preferences to get matching jobs') && !l.includes('IEIL has taken') && l.length > 0) {\n          // first such line is likely company? Actually company often appears first.\n          // We'll assume first such line is company, second is title.\n          if (!company) { company = l; }\n          else if (!title) { title = l; break; }\n        }\n      }\n    }\n    // if still no title, maybe title is the line that contains \"Sr\" or \"Engineer\" etc.\n    if (!title) {\n      for (const l of lines) {\n        if (l.match(/^(Senior|Lead|Principal|Director|Manager|Architect|Engineer|Analyst|Consultant|Specialist|Officer|Administrator|Developer|Designer|Specialist)/i)) {\n          title = l;\n          break;\n        }\n      }\n    }\n    // if still no title, take first line that is not a number or rating.\n    if (!title) {\n      for (const l of lines) {\n        if (!/^\\d+(\\.\\d+)?$/.test(l) && !l.includes('Reviews') && !l.includes('Yrs') && !l.includes('Lacs') && !l.includes('Save') && !l.includes('Hide')) {\n          title = l;\n          break;\n        }\n      }\n    }\n    // company: if we haven't set, maybe it's the first line of block.\n    if (!company) {\n      const firstLine = lines[0];\n      if (firstLine && !firstLine.includes('Yrs') && !firstLine.includes('Lacs') && !firstLine.includes('Save') && !firstLine.includes('Hide') && !firstLine.includes('Reviews') && !firstLine.includes('Posted by')) {\n        company = firstLine;\n      }\n    }\n    const lower = block.toLowerCase();\n    const matched = resumeSkillsLower.filter(skill => lower.includes(skill));\n    results.push({title: title || 'Unknown', company: company || 'Unknown', score: matched.length, matchedSkills: matched.slice(0,10), block: block.slice(0,200)});\n  }\n  return results;\n})()"}
