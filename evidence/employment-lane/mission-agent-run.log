[0mΓÜÖ [0mbrowser-mcp_browser_execute_script {"code":"(() => {\n  const resumeSkills = [\"node.js\",\"webrtc\",\"websocket\",\"aws\",\"react native\",\"microservices\",\"engineering management\",\"real-time systems\",\"java\",\"spring boot\",\"chatgpt\",\"claude\",\"mistral\",\"langchain\",\"rag\",\"vector database\",\"ai agents\",\"generative ai\",\"agentic ai\",\"llm\",\"java ee\",\"spring mvc\",\"activemq\",\"jms\",\"ci/cd\",\"linux\",\"solution architecture\",\"java 8\",\"rest apis\",\"upi\",\"rsa\",\"aes\",\"pki\",\"digital signatures\",\"npci\",\"idbi\",\"axis bank\",\"payment gateway\",\"cryptography\",\"rsa/aes/pki\",\"security engineering\",\"rbi compliance\",\"opennlp\",\"stanford nlp\",\"hadoop\",\"apache spark\",\"spring\",\"nlp\",\"machine learning\",\"r&d\",\"leadership\",\"llama\",\"bert\",\"nlp/nlg\",\"tensorflow\",\"gensim\",\"cloud & big data\",\"ec2\",\"lambda\",\"spark\",\"mongodb\",\"sql/nosql\",\"real-time processing\",\"data engineering\",\"architecture & backend\",\"cloud-native\",\"python\",\"devops & ci/cd\",\"docker\",\"jenkins\",\"maven\",\"git\",\"agile\",\"scrum\",\"team leadership\",\"tech roadmapping\",\"budget control\",\"stakeholder mgmt\",\"mentorship\",\"fintech\",\"logistics\",\"healthcare\",\"enterprise bi\",\"bpm\",\"crm\",\"itil\"];\n  const resumeSkillsLower = resumeSkills.map(s => s.toLowerCase());\n  // Get all slider items (job cards)\n  const sliderItems = Array.from(document.querySelectorAll('[data-testid=\"slider_item\"]'));\n  const jobs = [];\n  for (const item of sliderItems) {\n    const text = item.innerText;\n    const isEasyApply = text.includes('Easily apply');\n    // Extract role and company: we'll assume the first non-empty line is the role, the second non-empty line that is not \"Easily apply\" and not a rating is the company.\n    const lines = text.split('\\n').map(l => l.trim()).filter(l => l.length > 0);\n    let role = '';\n    let company = '';\n    let foundRole = false;\n    for (const line of lines) {\n      if (line.includes('Easily apply')) continue;\n      if (!foundRole && !line.includes('Γé╣') && !line.includes('/') && !line.includes('Remote') && !line.includes('Hybrid') && !line.includes('On-site') && !line.includes('View similar jobs') && !line.includes('Often replies') && !line.includes('Posted') && !line.includes('Save') && !line.includes('Apply')) {\n        role = line;\n        foundRole = true;\n        continue;\n      }\n      if (foundRole && !line.includes('Γé╣') && !line.includes('/') && !line.includes('Remote') && !line.includes('Hybrid') && !line.includes('On-site') && !line.includes('View similar jobs') && !line.includes('Often replies') && !line.includes('Posted') && !line.includes('Save') && !line.includes('Apply') && line !== role) {\n        company = line;\n        break;\n      }\n    }\n    // Fallback: if we didn't find company, set to first line after role that is not empty and not \"Easily apply\"\n    if (!company) {\n      for (let i = 0; i < lines.length; i++) {\n        if (lines[i] === role) {\n          // look ahead\n          for (let j = i+1; j < lines.length; j++) {\n            if (lines[j] && !lines[j].includes('Easily apply') && lines[j] !== role) {\n              company = lines[j];\n              break;\n            }\n          }\n          break;\n        }\n      }\n    }\n    // If still empty, set to unknown\n    if (!role) role = 'Unknown';\n    if (!company) company = 'Unknown';\n    const lower = text.toLowerCase();\n    const matched = resumeSkillsLower.filter(skill => lower.includes(skill));\n    jobs.push({role, company, score: matched.length, matchedSkills: matched.slice(0,10), isEasyApply});\n  }\n  return jobs;\n})()"}
