[0mΓÜÖ [0mbrowser-mcp_browser_execute_script {"code":"(() => {\n  // Find all job cards: Indeed uses a specific structure; we'll look for elements with data-testid=\"slider_item\" or class=\"slider_item\"\n  const sliderItems = Array.from(document.querySelectorAll('[data-testid=\"slider_item\"]'));\n  const jobs = [];\n  for (const item of sliderItems) {\n    const text = item.innerText;\n    // Check if it contains a job title and company\n    // We'll extract title as the first line that looks like a job title (contains certain keywords or is before company)\n    // For simplicity, we'll just take the whole text and later parse.\n    // Determine if it's an easy apply: look for \"Easily apply\" in the text.\n    const isEasyApply = text.includes('Easily apply');\n    // Extract title and company: heuristic: first line is often title, second line company? Not reliable.\n    // We'll just use the whole text for skill matching.\n    jobs.push({text, isEasyApply});\n  }\n  return jobs.slice(0,10); // first 10\n})()"}
