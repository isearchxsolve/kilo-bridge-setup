e},\n    {text:\"AI engineer\\nEasily apply\\nMyData Insights Private Limited\\nRemote\", isEasyApply:true},\n    {text:\"Engineering Manager\\nEasily apply\\nAgara\\nRemote in Bengaluru, Karnataka\", isEasyApply:true},\n    {text:\"Senior Software Engineer - AI Trainer\\nEasily apply\\nDataAnnotation\\nRemote in Pune, Maharashtra\\nΓé╣75 - Γé╣150 an hour\\nFull-timeΓÇé+2\\nWork from home\\nFlexible schedule\", isEasyApply:true},\n    {text:\"Platform Engineer - AI Trainer\\nEasily apply\\nDataAnnotation\\nRemote in Chennai, Tamil Nadu\\nΓé╣7,195.34 - Γé╣14,390.68 an hour\\nFull-timeΓÇé+1\\nWork from home\\nFlexible schedule\\nView similar jobs with this employer\", isEasyApply:true},\n    {text:\"Platform Engineer - AI TrainerEasily applyDataAnnotationRemote in Chennai, Tamil NaduΓé╣7,195.34 - Γé╣14,390.68 an hourFull-timeΓÇé+1Work from homeFlexible scheduleView similar jobs with this employer\", isEasyApply:true},\n    {text:\"Platform Engineer - AI Trainer\\nEasily apply\\nDataAnnotation\\nRemote in Pune, Maharashtra\\nΓé╣7,195.34 - Γé╣14,390.68 an hour\\nFull-timeΓÇé+1\\nWork from home\\nFlexible schedule\\nView similar jobs with this employer\", isEasyApply:true}\n  ];\n  const results = jobs.map(job => {\n    const lower = job.text.toLowerCase();\n    const matched = resumeSkillsLower.filter(skill => lower.includes(skill));\n    return {text: job.text.substring(0,100), isEasyApply: job.isEasyApply, score: matched.length, matchedSkills: matched.slice(0,5)};\n  });\n  return results;\n})()"}
