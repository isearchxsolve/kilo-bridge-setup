i<lines.length; i++) {\n      if (lines[i] && !lines[i].includes('Yrs') && !lines[i].includes('Lacs') && !lines[i].includes('Save') && !lines[i].includes('Hide') && !lines[i].includes('Reviews') && !lines[i].includes('Posted by') && !lines[i].includes('WeΓÇÖre urgently hiring') && !lines[i].includes('Matching jobs promoted by companies') && !lines[i].includes('Add preferences to get matching jobs') && !lines[i].includes('IEIL has taken')) {\n        if (!title) { title = lines[i]; continue; }\n        if (!company) { company = lines[i]; break; }\n      }\n    }\n    // fallback: first line is title, second line is company\n    if (!title) title = lines[0] || '';\n    if (!company) company = lines[1] || '';\n    const lower = block.toLowerCase();\n    const matched = resumeSkillsLower.filter(skill => lower.includes(skill));\n    return {title, company, block, score:matched.length, matchedSkills:matched.slice(0,10)};\n  });\n  return results;\n})()"}
