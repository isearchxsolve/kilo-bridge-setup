[0m⚙ [0mbrowser-mcp_browser_execute_script {"code":"(() => {\n  const text = document.body.innerText;\n  // Split by double newline to get blocks\n  const blocks = text.split('\\n\\n');\n  const jobs = [];\n  const candidateSkills = [\"node.js\",\"webrtc\",\"websocket\",\"aws\",\"react native\",\"microservices\",\"engineering management\",\"real-time systems\",\"java\",\"spring boot\",\"chatgpt\",\"claude\",\"mistral\",\"langchain\",\"rag\",\"vector database\",\"ai agents\",\"generative ai\",\"agentic ai\",\"llm\",\"java ee\",\"spring mvc\",\"activemq\",\"jms\",\"ci/cd\",\"linux\",\"solution architecture\",\"java 8\",\"rest apis\",\"upi\",\"rsa\",\"aes\",\"pki\",\"digital signatures\",\"npci\",\"idbi\",\"axis bank\",\"payment gateway\",\"cryptography\",\"rsa/aes/pki\",\"security engineering\",\"rbi compliance\",\"opennlp\",\"stanford nlp\",\"hadoop\",\"apache spark\",\"spring\",\"nlp\",\"machine learning\",\"r&d\",\"leadership\",\"llama\",\"bert\",\"nlp/nlg\",\"tensorflow\",\"gensim\",\"cloud & big data\",\"ec2\",\"lambda\",\"spark\",\"mongodb\",\"sql/nosql\",\"real-time processing\",\"data engineering\",\"architecture & backend\",\"cloud-native\",\"python\",\"devops & ci/cd\",\"docker\",\"jenkins\",\"maven\",\"git\",\"agile\",\"scrum\",\"team leadership\",\"tech roadmapping\",\"budget control\",\"stakeholder mgmt\",\"mentorship\",\"fintech\",\"logistics\",\"healthcare\",\"enterprise bi\",\"bpm\",\"crm\",\"itil\"];\n  for (const block of blocks) {\n    const lines = block.split('\\n').map(l => l.trim()).filter(l => l.length > 0);\n    if (lines.length < 2) continue;\n    // Skip blocks that are clearly not job postings\n    const joined = lines.join(' ');\n    if (joined.includes('Trending companies') || joined.includes('Why Join Us:') || joined.includes('Follow') || joined.includes('View Jobs') || joined.includes('Add preferences to get matching jobs') || joined.includes('IEIL has taken all reasonable steps')) {\n      continue;\n    }\n    // Assume first line is job title, second line is company\n    const title = lines[0];\n    const company = lines[1];\n    // Compute score: count of candidate skills present in the block (case-insensitive)\n    const lowerBlock = block.toLowerCase();\n    let score = 0;\n    for (const skill of candidateSkills) {\n      if (lowerBlock.includes(skill.toLowerCase())) {\n        score++;\n      }\n    }\n    jobs.push({title, company, block, score});\n  }\n  // Sort by score descending\n  jobs.sort((a, b) => b.score - a.score);\n  return jobs.slice(0, 10); // return top 10\n})()"}
